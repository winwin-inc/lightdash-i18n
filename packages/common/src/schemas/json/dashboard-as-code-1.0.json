                                        },
                                        "title": {
                                            "type": "string"
                                        }
                                    },
                                    "required": ["content", "title"],
                                    "type": "object"
                                },
                                {
                                    "properties": {
                                        "hideTitle": {
                                            "type": "boolean"
                                        },
                                        "title": {
                                            "type": "string"
                                        },
                                        "url": {
                                            "type": "string"
                                        }
                                    },
                                    "required": ["url", "title"],
                                    "type": "object"
                                },
                                {
                                    "$ref": "#/$defs/Pick_DashboardSqlChartTileProperties-at-properties.title-or-hideTitle-or-chartName-or-chartSlug_"
                                },
                                {
                                    "$ref": "#/$defs/Pick_DashboardDataAppTileProperties-at-properties.title-or-hideTitle-or-appUuid-or-appSlug-or-appDeletedAt_"
                                }
                            ]
                        },
                        "tabSlug": {
                            "type": ["string", "null"]
                        },
                        "tileSlug": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": ["properties"],
                    "type": "object"
                }
            ]
