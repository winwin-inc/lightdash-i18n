{
    "$defs": {
        "AnyType": {
            "description": "This AnyType is an alias for any\nThe goal is to make it easier to identify any type in the codebase\nwithout having to eslint-disable all the time\nThese are only used on legacy `any` types, don't use it for new types.\nThis is added on a separate file to avoid circular dependencies."
        },
        "ContentAsCodeType.DASHBOARD": {
            "enum": ["dashboard"],
            "type": "string"
        },
        "DashboardConfig": {
            "properties": {
                "colorPalette": {
                    "description": "看板级别的颜色调色板，当 syncChartColors 开启时使用",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "isDateZoomDisabled": {
                    "type": "boolean"
                },
                "isGlobalFilterEnabled": {
                    "type": "boolean"
                },
                "pinnedParameters": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "requiredFiltersNote": {
                    "description": "Editor-authored note shown to viewers while filter rules are unmet",
                    "type": "string"
                },
                "showGlobalAddFilterButton": {
                    "type": "boolean"
                },
                "showTabAddFilterButton": {
                    "$ref": "#/$defs/Record_string.boolean_"
                },
                "syncChartColors": {
                    "description": "开启颜色同步功能",
                    "type": "boolean"
                },
                "syncChartTileUuids": {
                    "description": "记录需要同步颜色的图表 tile uuid 列表",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "tabFilterEnabled": {
                    "$ref": "#/$defs/Record_string.boolean_"
                }
            },
            "required": ["isDateZoomDisabled"],
            "type": "object"
        },
        "DashboardFieldTarget": {
            "properties": {
                "fallbackType": {
                    "$ref": "#/$defs/DimensionType"
                },
                "fieldId": {
                    "type": "string"
                },
                "fieldLabel": {
                    "type": "string"
                },
                "fieldName": {
                    "type": "string"
                },
                "isSqlColumn": {
                    "type": "boolean"
                },
                "tableLabel": {
                    "type": "string"
                },
                "tableName": {
                    "type": "string"
                }
            },
            "required": ["tableName", "fieldId"],
            "type": "object"
        },
        "DashboardFilterRule": {
            "allOf": [
                {
                    "$ref": "#/$defs/FilterRule_FilterOperator.DashboardFieldTarget.AnyType.AnyType_"
                },
                {
                    "properties": {
                        "allowedOperators": {
                            "description": "Operators available to viewers; undefined/empty means no restriction",
                            "items": {
                                "$ref": "#/$defs/FilterOperator"
                            },
                            "type": "array"
                        },
                        "categoryLevel": {
                            "enum": [1, 2, 3, 4],
                            "type": "number"
                        },
                        "enableDynamicMaxAllowedDate": {
                            "description": "When true and maxAllowedDate is empty, month/quarter pickers use a\nrolling latest date (before the 4th: two months ago; from the 4th:\nlast month; quarters: last complete quarter). Default is off.",
                            "type": "boolean"
                        },
                        "excludedValues": {
                            "description": "Values hidden from filter options list",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "hidden": {
                            "description": "Hidden filter: not displayed on page, but filter still applies",
                            "type": "boolean"
                        },
                        "label": {
                            "type": "string"
                        },
                        "lockedTabUuids": {
                            "description": "Tab UUIDs where this filter is locked. When the active tab is in this\nlist, viewers see the filter but cannot change it, and URL / embed\nfilter overrides targeting the same field are ignored on that tab.\nEmpty or omitted means the filter is not locked anywhere.",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "maxAllowedDate": {
                            "type": "string"
                        },
                        "minAllowedDate": {
                            "description": "Optional selectable range for date inputs (YYYY-MM-DD)",
                            "type": "string"
                        },
                        "parentFieldId": {
                            "type": "string"
                        },
                        "readOnly": {
                            "type": "boolean"
                        },
                        "requiredGroupId": {
                            "description": "Dashboard filters sharing a requiredGroupId form an \"any-one required\"\ngroup: the dashboard is locked until at least one member has a value.",
                            "type": "string"
                        },
                        "singleValue": {
                            "type": "boolean"
                        },
                        "tileTargets": {
                            "$ref": "#/$defs/Record_string.DashboardTileTarget_"
                        }
                    },
                    "type": "object"
                }
            ]
        },
        "DashboardFilterRule_FilterOperator.DashboardFieldTarget.any.any_": {
            "allOf": [
                {
                    "$ref": "#/$defs/FilterRule_FilterOperator.DashboardFieldTarget.any.any_"
