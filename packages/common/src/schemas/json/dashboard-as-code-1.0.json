                            "type": "boolean"
                        },
                        "excludedValues": {
                            "description": "Values hidden from filter options list",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "hidden": {
                            "description": "Hidden filter: not displayed on page, but filter still applies",
                            "type": "boolean"
                        },
                        "label": {
                            "type": "string"
                        },
                        "lockedTabUuids": {
                            "description": "Tab UUIDs where this filter is locked. When the active tab is in this\nlist, viewers see the filter but cannot change it, and URL / embed\nfilter overrides targeting the same field are ignored on that tab.\nEmpty or omitted means the filter is not locked anywhere.",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "maxAllowedDate": {
                            "type": "string"
                        },
                        "minAllowedDate": {
                            "description": "Optional selectable range for date inputs (YYYY-MM-DD)",
                            "type": "string"
                        },
                        "parentFieldId": {
                            "type": "string"
                        },
                        "readOnly": {
                            "type": "boolean"
                        },
                        "requiredGroupId": {
                            "description": "Dashboard filters sharing a requiredGroupId form an \"any-one required\"\ngroup: the dashboard is locked until at least one member has a value.",
                            "type": "string"
                        },
                        "singleValue": {
                            "type": "boolean"
                        },
                        "tileTargets": {
                            "$ref": "#/$defs/Record_string.DashboardTileTarget_"
                        }
                    },
                    "type": "object"
                }
            ]
