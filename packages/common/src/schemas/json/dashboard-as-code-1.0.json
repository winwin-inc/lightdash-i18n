                            "required": ["dimensions"],
                            "type": "object"
                        }
                    ],
                    "description": "Fork-specific tab-level filters. Must survive as-code round-trip."
                },
                "hidden": {
                    "description": "Hidden tabs are omitted from the tab bar in view mode.",
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "order": {
                    "format": "double",
                    "type": "number"
                },
                "uuid": {
                    "type": "string"
                }
            },
            "required": ["order", "name", "uuid"],
            "type": "object"
