            "properties": {
                "parameterName": {
                    "type": "string"
                },
                "value": {
                    "$ref": "#/$defs/ParameterValue"
                }
            },
            "required": ["value", "parameterName"],
            "type": "object"
        },
        "DashboardTab": {
            "additionalProperties": false,
            "properties": {
                "filters": {
                    "allOf": [
                        {
                            "$ref": "#/$defs/Omit_DashboardFilters.dimensions_"
                        },
                        {
                            "properties": {
                                "dimensions": {
