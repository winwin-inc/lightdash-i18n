                    },
                    "type": "array"
                }
            },
            "required": ["tableCalculations", "metrics", "dimensions"],
            "type": "object"
        },
        "DashboardParameters": {
            "$ref": "#/$defs/Record_string.DashboardParameterValue_"
        },
