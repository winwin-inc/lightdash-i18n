{
  "connectors": {
    "msy-x": {
      "install": {
        "default": [
          "npm install -g https://img0.banmahui.cn/msy-x/cli/msy-x-cli/0.2.1/msy-x-cli-0.2.1.tgz"
        ]
      },
      "versionCheck": {
        "default": [
          "msy-x --version"
        ]
      },
      "statusMatchRegex": "\"logged_in\"\\s*:\\s*true",
      "auth": {
        "default": [
          "msy-x auth login"
        ]
      },
      "unAuth": {
        "default": [
          "msy-x auth logout"
        ]
      },
      "status": {
        "default": [
          "msy-x auth status"
        ]
      },
      "help": {
        "default": [
          "msy-x --help"
        ]
      }
    }
  }
}
